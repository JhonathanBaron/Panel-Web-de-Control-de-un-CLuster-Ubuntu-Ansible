# ============================================================
# Usuarios del cluster
# ============================================================
# Rango de UIDs por rol:
#   professor: 20000 - 29999
#   student:   30000 - 39999
#   guest:     40000 - 49999

users:
  - username: profesor.ejemplo
    fullname: Profesor Ejemplo
    uid: 20001
    role: professor
    active: true
    created: '2026-01-01'

  - username: estudiante.ejemplo
    fullname: Estudiante Ejemplo
    uid: 30001
    role: student
    active: true
    created: '2026-01-01'

  - username: invitado.ejemplo
    fullname: Invitado Ejemplo
    uid: 40001
    role: guest
    active: true
    created: '2026-01-01'

config:
  shell: /bin/bash
  home_base: /srv/nas/home
  default_quota_gb: 10